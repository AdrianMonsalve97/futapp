# Puerto del backend
PORT=4000

# Origen permitido para CORS (frontend en desarrollo)
CORS_ORIGIN=http://localhost:5173

# Secreto para firmar los JWT (cámbialo en producción)
JWT_SECRET=cambiame-en-produccion-9f2b7a1c
JWT_EXPIRES_IN=8h
# Cierre por inactividad solo para jugadores (1–240 minutos); administradores exentos.
PLAYER_IDLE_MINUTES=15

# Ruta de la base de datos SQLite (relativa a backend/)
DB_PATH=./data/portal.db
# Modo local. Para Render usa DB_DRIVER=postgres y las variables privadas siguientes.
DB_DRIVER=sqlite
# DATABASE_URL=  (Supabase Session pooler, puerto 5432; contraseña codificada para URI)
# SUPABASE_URL=  (https://referencia.supabase.co)
# SUPABASE_SECRET_KEY=  (clave del servidor, nunca VITE_* ni publishable)
# SUPABASE_STORAGE_BUCKET=futapp-media
# SUPABASE_DB_CA=  (certificado PEM si la conexión necesita la CA del proyecto)
# Bot de notificaciones (desactivado hasta conectar proveedor y destinatarios en el administrador).
# Credenciales solo en el servidor; no introducirlas en React ni subir .env a Git.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Usa la versión admitida por tu aplicación de Meta, por ejemplo v26.0 si aparece en su panel.
WHATSAPP_API_VERSION=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Grupo existente con Evolution API (sesión WHATSAPP-BAILEYS de un número exclusivo).
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=futapp-bot
PUBLIC_APP_URL=
# Solo para el primer arranque de una instalación nueva. No reemplaza cuentas existentes.
BOOTSTRAP_ADMIN=0
ADMIN_EMAIL=admin@futapp.local
ADMIN_NAME=Administrador de migración
ADMIN_PASSWORD=

# Recuperación de contraseñas por HTTPS con Brevo. Verifica el remitente en Brevo.
# En Render se aplican mediante secretos de GitHub Actions; nunca variables VITE_*.
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=FutApp
